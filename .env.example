# NavDrishtiAI Environment Configuration
# SIH26248: Immersive Multi-Domain Decision-Making Trainer for Degraded Communication Environments

# Backend Configuration
DATABASE_URL="file:./dev.db" # In production: postgresql://user:password@localhost:5432/navdrishti
PORT=5000
NODE_ENV=development
JWT_SECRET="replace_with_a_secure_random_64_character_key"
JWT_REFRESH_SECRET="replace_with_a_separate_secure_random_key"
CORS_ORIGIN="http://localhost:3000"
CLIENT_URL="http://localhost:3000"
COOKIE_SECURE="false" # Set to "true" in production with HTTPS

# Frontend Configuration
NEXT_PUBLIC_API_URL="http://localhost:5000"
NEXT_PUBLIC_SOCKET_URL="http://localhost:5000"
